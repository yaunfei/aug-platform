# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=aug_platform
# 显式覆盖时优先于上面五项（测试可用 sqlite+aiosqlite:////tmp/test.db）
# DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/aug_platform

# ===== 服务 =====
API_PORT=8100
MAX_BODY_BYTES=1048576
UPLOAD_MAX_BODY_BYTES=6291456

# ===== 鉴权（仅 /api/ 生效）=====
AUTH_ENABLED=false
AUTH_TOKEN=change-me

# ===== AI（mock 无外部依赖；openai 走三链路降级）=====
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRY=2
AI_CHAT_DEADLINE_SECONDS=90
AI_CHAT_MAX_TOOL_ROUNDS=3
AI_CHAT_MAX_CALLS_PER_ROUND=4
AI_CHAT_TOOL_RESULT_BUDGET=12000

# ===== 提交 Webhook =====
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ===== 日志 =====
LOG_LEVEL=INFO
# 留空仅输出控制台；配置后启用 10MB×5 轮转文件
LOG_FILE=
