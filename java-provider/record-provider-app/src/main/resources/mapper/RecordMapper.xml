<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aug.record.provider.mapper.RecordMapper">

  <resultMap id="recordRowMap" type="com.aug.record.provider.mapper.RecordRow">
    <id property="id" column="id"/>
    <result property="schemaVersion" column="schema_version"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="createdBy" column="created_by"/>
    <result property="data" column="data"/>
  </resultMap>

  <!-- 与 server/app/repositories/record_repo.py 的 whereClause 形状保持一致：
       keyword 走 cast(data AS text) ILIKE（命中 pg_trgm GIN 表达式索引）；
       字符串 filters → data->>field ILIKE；数字/布尔 → data @> jsonb_build_object。 -->
  <sql id="whereClause">
    <where>
      form_key = #{q.formKey}
      <if test="q.startTime != null">
        AND created_at &gt;= #{q.startTime}
      </if>
      <if test="q.endTime != null">
        AND created_at &lt;= #{q.endTime}
      </if>
      <if test="q.keyword != null and q.keyword != ''">
        AND CAST(data AS TEXT) ILIKE CONCAT('%', #{q.keyword}, '%')
      </if>
      <foreach collection="q.filters" item="f">
        <choose>
          <when test="f.textMatch">
            AND data-&gt;&gt;#{f.field} ILIKE CONCAT('%', #{f.stringValue}, '%')
          </when>
          <otherwise>
            AND data @&gt; jsonb_build_object(#{f.field}, CAST(#{f.jsonLiteral} AS jsonb))
          </otherwise>
        </choose>
      </foreach>
    </where>
  </sql>

  <select id="countRecords" resultType="long">
    SELECT COUNT(*)
    FROM form_record
    <include refid="whereClause"/>
  </select>

  <select id="selectPage" resultMap="recordRowMap">
    SELECT id,
           schema_version,
           created_at,
           updated_at,
           created_by,
           data::text AS data
    FROM form_record
    <include refid="whereClause"/>
    ORDER BY created_at DESC, id DESC
    OFFSET #{offset} LIMIT #{limit}
  </select>

  <select id="selectDetail" resultMap="recordRowMap">
    SELECT id,
           schema_version,
           created_at,
           updated_at,
           created_by,
           data::text AS data
    FROM form_record
    WHERE form_key = #{formKey}
      AND id = #{id}
    LIMIT 1
  </select>

</mapper>
