{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "../*"
      ],
      "@@/*": [
        "../.umi/*"
      ],
      "@umijs/max": [
        "../node_modules/.pnpm/umi@4.7.35_@babel+core@7.23.6_@types+node@26.6.6_@types+react@18.3.31_jiti@2.7.0_lightn_caf7a137dcf5f4c73eb9cf4fb7af54a5/node_modules/umi"
      ],
      "@umijs/max/typings": [
        "../.umi/typings"
      ]
    }
  },
  "include": [
    "../.umirc.ts",
    "../.umirc.*.ts",
    "../**/*.d.ts",
    "../**/*.ts",
    "../**/*.tsx"
  ]
}
