{
  "extends": "./.umi/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./.umi/*"],
      "@umijs/max": ["./node_modules/@umijs/max"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    ".umirc.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".umi/typings.d.ts"
  ]
}
